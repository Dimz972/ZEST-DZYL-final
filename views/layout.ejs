              <% if (cart && cart.length > 0) { %> 
              <% let total = 0; %> 
              <% cart.forEach(function(item, index) { %> 
              <% 
                // Déterminer si c'est un plat ou un article
                const isPlat = item.plat !== undefined;
                const isArticle = item.article !== undefined;
                const currentItem = isPlat ? item.plat : item.article;
                const itemType = isPlat ? 'plat' : 'article';
              %>
              <div
                style="
                  border: 1px solid #ccc;
                  margin: 5px;
                  padding: 5px;
                  border-radius: 5px;
                "
              >
                <h3><b><%= currentItem.name.length > 15 ? currentItem.name.substring(0, 15) + '...' : currentItem.name %></b></h3>
                <p><b>Prix unitaire:</b> <%= currentItem.price %> €</p>
                <p><b>Quantité:</b> <%= item.quantity %></p>
                <p>
                  <b>Sous-total:</b> <%= (currentItem.price *
                  item.quantity).toFixed(2) %> €
                </p>
                <% total += currentItem.price * item.quantity; %>
                
                 <button onclick="removeFromCart('<%= currentItem._id %>', '<%= itemType %>')" type="button" title="Supprimer" class="btn-hover-effect cursor-pointer inline-flex items-center justify-center p-2 text-sm font-medium text-white bg-red-700 border border-transparent rounded-lg hover:bg-red-800 focus:ring-4 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                    </button>
              </div>
              <% }); %>

              <div
                style="
                  margin-top: 5px;
                  padding: 5px;
                  background-color: #f8f9fa;
                  border-radius: 5px;
                "
              >
