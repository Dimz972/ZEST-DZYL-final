<section class="bg-gray-50 dark:bg-gray-900 p-3 sm:p-5">
    <div class="mx-auto max-w-screen-xl px-4 lg:px-12">
        <a href="/dashboard/admin" class="btn-hover-effect font-medium inline-flex items-center text-white px-4 py-2 rounded-lg mb-6 bg-blue-700 hover:bg-blue-800">
            <i class="fas fa-arrow-left mr-2"></i> Retour au dashboard
        </a>
        <div class="bg-white dark:bg-gray-800 relative shadow-md sm:rounded-lg overflow-hidden">
            <div class="flex flex-col md:flex-row items-center justify-between space-y-3 md:space-y-0 md:space-x-4 p-4">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Liste des messages de contact</h2>
            </div>
            
            <!-- Section des filtres -->
            <div class="p-4 border-b border-gray-200 dark:border-gray-700">
                <div class="flex flex-wrap items-end gap-4">
                    <!-- Filtre par statut -->
                    <div class="flex-1 min-w-48">
                        <label for="statusFilter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Filtrer par statut :
                        </label>
                        <select id="statusFilter" class="bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                            <option value="tous">Tous les statuts</option>
                            <option value="nouveau">Nouveau</option>
                            <option value="lu">Lu</option>
                        </select>
                    </div>
                    
                    <!-- Filtre par date -->
                    <div class="flex-1 min-w-48">
                        <label for="dateFilter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Trier par date :
                        </label>
                        <select id="dateFilter" class="bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                            <option value="desc">Plus récent en premier</option>
                            <option value="asc">Plus ancien en premier</option>
                        </select>
                    </div>
                    
                    <!-- Bouton pour réinitialiser les filtres -->
                    <div class="flex-shrink-0">
                        <button id="resetFilters" class="bg-gray-500 hover:bg-gray-600 text-white font-medium py-2.5 px-4 rounded text-sm transition-colors duration-200">
                            Réinitialiser
                        </button>
                    </div>
                </div>
            </div>
            
            <% if (contacts && contacts.length > 0) { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                            <tr>
                                <th class="px-4 py-3">Statut</th>
                                <th class="px-4 py-3">Date</th>
                                <th class="px-4 py-3">Sujet</th>
                                <th class="px-4 py-3">Email</th>
                                <th class="px-4 py-3">Message</th>
                                <th class="px-4 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% contacts.forEach(contact => { %>
                            <tr class="border-b dark:border-gray-700 align-top" data-contact-id="<%= contact._id %>" data-date="<%= contact.createdAt %>">
                                <td class="px-4 py-3">
                                    <span class="badge <%= contact.status === 'nouveau' ? 'bg-red-100 text-red-800' : contact.status === 'lu' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800' %> text-xs font-medium px-2.5 py-0.5 rounded">
                                        <%= contact.status.charAt(0).toUpperCase() + contact.status.slice(1) %>
                                    </span>
                                </td>
                                <td class="px-4 py-3">
                                    <%= new Date(contact.createdAt).toLocaleDateString('fr-FR', { 
                                        year: 'numeric', 
                                        month: 'long', 
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>
                                </td>
                                <td class="px-4 py-3 font-semibold text-gray-900 dark:text-white"><%= contact.subject %></td>
                                <td class="px-4 py-3"><%= contact.email %></td>
                                <td class="px-4 py-3"><%= contact.message %></td>
                                <td class="px-4 py-3 space-y-2">
                                    <% if (contact.status === 'nouveau') { %>
                                        <button onclick="markAsRead('<%= contact._id %>')" title="Marquer comme lu" class="mr-2 btn-hover-effect cursor-pointer inline-flex items-center justify-center p-2 text-sm font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                        </button>
                                    <% } %>
                                      <button onclick="deleteContact('<%= contact._id %>')" title="Supprimer ce message" class="btn-hover-effect cursor-pointer inline-flex items-center justify-center p-2 text-sm font-medium text-white bg-red-700 rounded-lg hover:bg-red-800 focus:ring-4 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                      </button>
                                   
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center">
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8">
                    <h2 class="text-2xl font-semibold text-gray-600 dark:text-gray-300 mb-4">Aucun message trouvé</h2>
                    <p class="text-gray-500 dark:text-gray-400 mb-6">Les messages apparaîtront ici une fois envoyés !</p>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</section>





<script>
// Variables globales pour la gestion des contacts
let contactsData = [];

// Fonctions utilitaires
function initializeContactsData() {
    const tableRows = document.querySelectorAll('tbody tr[data-contact-id]');
    contactsData = Array.from(tableRows).map(row => ({
        id: row.getAttribute('data-contact-id'),
        status: row.querySelector('.badge').textContent.trim().toLowerCase(),
        dateValue: new Date(row.getAttribute('data-date')),
        element: row
    }));
}

function filterAndSortContacts(statusFilter, dateFilter) {
    let filtered = contactsData.filter(contact => 
        statusFilter === 'tous' || contact.status === statusFilter
    );
    
    return filtered.sort((a, b) => 
        dateFilter === 'asc' 
            ? a.dateValue - b.dateValue 
            : b.dateValue - a.dateValue
    );
}

function updateContactsDisplay(filteredContacts) {
    const tbody = document.querySelector('tbody');
    
    // Masquer tous les contacts
    contactsData.forEach(contact => contact.element.style.display = 'none');
    
    // Afficher et réorganiser les contacts filtrés
    filteredContacts.forEach(contact => {
        contact.element.style.display = '';
        tbody.appendChild(contact.element);
    });
    
    // Gérer le message "aucun résultat"
    toggleNoResultsMessage(filteredContacts.length === 0);
}

function toggleNoResultsMessage(show) {
    const tbody = document.querySelector('tbody');
    let messageRow = document.getElementById('no-results-message');
    
    if (show && !messageRow) {
        messageRow = document.createElement('tr');
        messageRow.id = 'no-results-message';
        messageRow.innerHTML = `
            <td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
                <div class="flex flex-col items-center">
                    <svg class="w-12 h-12 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.462-.943-6-2.47A7.963 7.963 0 016 12.01C6 9.77 7.8 8 10 8s4 1.77 4 4c0 .99-.51 1.907-1.414 2.414z"/>
                    </svg>
                    <p class="text-lg">Aucun message ne correspond aux critères sélectionnés</p>
                </div>
            </td>
        `;
        tbody.appendChild(messageRow);
    } else if (!show && messageRow) {
        messageRow.remove();
    }
}

// Initialisation au chargement de la page
document.addEventListener('DOMContentLoaded', function() {
    initializeContactsData();
    
    // Gestionnaires d'événements pour les filtres
    document.getElementById('statusFilter').addEventListener('change', applyFilters);
    document.getElementById('dateFilter').addEventListener('change', applyFilters);
    document.getElementById('resetFilters').addEventListener('click', resetFilters);
});

function applyFilters() {
    const statusFilter = document.getElementById('statusFilter').value;
    const dateFilter = document.getElementById('dateFilter').value;
    
    const filteredContacts = filterAndSortContacts(statusFilter, dateFilter);
    updateContactsDisplay(filteredContacts);
}

function resetFilters() {
    document.getElementById('statusFilter').value = 'tous';
    document.getElementById('dateFilter').value = 'desc';
    applyFilters();
}

// Fonctions de gestion des contacts
async function handleContactAction(contactId, action, method) {
    try {
        const response = await fetch(`/admin/contacts/${contactId}${action}`, {
            method: method,
            headers: { 'Content-Type': 'application/json' }
        });

        const result = await response.json();
        
        if (result.success) {
            if (method === 'PATCH') {
                location.reload(); // Recharger pour voir le changement de statut
            } else {
                // Supprimer de l'affichage et des données
                removeContactFromDisplay(contactId);
            }
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Erreur',
                text: result.error,
                confirmButtonColor: '#3b82f6'
            });
        }
    } catch (error) {
        console.error('Erreur:', error);
        Swal.fire({
            icon: 'error',
            title: 'Erreur',
            text: 'Une erreur est survenue',
            confirmButtonColor: '#3b82f6'
        });
    }
}

function removeContactFromDisplay(contactId) {
    const contactElement = document.querySelector(`[data-contact-id="${contactId}"]`);
    if (contactElement) {
        contactElement.remove();
        // Mettre à jour les données
        contactsData = contactsData.filter(contact => contact.id !== contactId);
        applyFilters();
    }
}

async function markAsRead(contactId) {
    await handleContactAction(contactId, '/read', 'PATCH');
}

async function deleteContact(contactId) {
    const result = await Swal.fire({
        title: 'Êtes-vous sûr ?',
        text: 'Voulez-vous vraiment supprimer ce message ?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Oui, supprimer',
        cancelButtonText: 'Annuler'
    });
    
    if (result.isConfirmed) {
        await handleContactAction(contactId, '', 'DELETE');
    }
}
</script>
