

<section class="bg-gray-50 dark:bg-gray-900 p-3 sm:p-5">
    <div class="mx-auto max-w-screen-xl px-4 lg:px-12">
        <a href="/dashboard/admin" class="btn-hover-effect font-medium inline-flex items-center text-white px-4 py-2 rounded-lg mb-6 bg-blue-700 hover:bg-blue-800">
            <i class="fas fa-arrow-left mr-2"></i> Retour au dashboard
        </a>
        <div class="bg-white dark:bg-gray-800 relative shadow-md sm:rounded-lg overflow-x-auto">
            <div class="flex flex-col md:flex-row items-center justify-between space-y-3 md:space-y-0 md:space-x-4 p-4">
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Liste des recettes</h1>
                <!-- <a href="/recettes/admin/add" class="flex items-center justify-center text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
                    <svg class="h-4 w-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
                    Ajouter une recette
                </a> -->
                <!-- Modal toggle -->
                <button id="defaultModalButton" data-modal-target="defaultModal" data-modal-toggle="defaultModal" class="btn-hover-effect cursor-pointer flex items-center justify-center text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800" type="button">
                    <svg class="h-4 w-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
                    Ajouter une recette
                </button>

<% if (typeof successMessage !== 'undefined' && successMessage) { %>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        Swal.fire({
            icon: 'success',
            title: 'Succès !',
            text: '<%= successMessage %>',
            confirmButtonColor: '#3b82f6',
            timer: 3000,
            showConfirmButton: false
        });
    });
</script>
<% } %>
                


<!-- Main modal -->
<div id="defaultModal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-auto fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-modal md:h-full">
    <div class="relative p-4 w-full max-w-4xl h-full md:h-auto">
        <!-- Modal content -->
    <div class="relative p-4 bg-white rounded-lg shadow dark:bg-gray-800 sm:p-5 max-w-4xl mx-auto w-full">
            <!-- Modal header -->
            <section class="bg-gray-50 rounded-lg py-4 antialiased dark:bg-gray-900 md:py-12">
    <div class="mx-auto max-w-screen-xl px-4 2xl:px-0">
        <div class="px-4 mx-auto max-w-4xl">
            <h1 class="text-3xl font-bold text-center mb-6 text-blue-600">Ajouter une recette</h1>
            
            <!-- Carte formulaire -->
            <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-md dark:border-gray-700 dark:bg-gray-800">
                <form action="/recettes/add" method="POST" id="recetteForm" enctype="multipart/form-data">
                    <div class="grid gap-6 grid-cols-1 lg:grid-cols-2">
                        <!-- Section Image -->
                        <div>
                            <label for="image" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Image de la recette</label>
                            <div class="h-56 w-full border-2 border-dashed border-gray-300 rounded-lg flex items-center justify-center bg-gray-50 dark:bg-gray-700 dark:border-gray-600">
                                <input 
                                    type="file" 
                                    id="image" 
                                    name="image"
                                    class="hidden"
                                    onchange="previewImage(event)"
                                >
                                <div id="imagePreview" class="hidden h-full w-full">
                                    <img id="previewImg" class="h-full w-full object-cover rounded-lg" src="" alt="Aperçu">
                                </div>
                                <div id="uploadPlaceholder" class="text-center">
                                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                    </svg>
                                    <button type="button" onclick="document.getElementById('image').click()" class="cursor-pointer mt-2 text-sm text-blue-600 hover:text-blue-700">
                                        Cliquez pour ajouter une image
                                    </button>
                                    <p class="text-xs text-gray-500 mt-1">PNG, JPG, GIF jusqu'à 5MB</p>
                                </div>
                            </div>
                        </div>

                        <!-- Section Informations principales -->
                        <div class="space-y-4">
                            <div>
                                <label for="name" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Nom de la recette </label>
                                <input 
                                    type="text" 
                                    id="name" 
                                    name="name" 
                                    required 
                                    placeholder="Entrez le nom de la recette"
                                    value="<%= typeof recette !== 'undefined' ? recette.name : '' %>"
                                    class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                >
                            </div>

                            <div>
                                <label for="category" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Catégorie</label>
                                <select id="category" name="category" required class="cursor-pointer w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                    <option value="">Sélectionnez la catégorie</option>
                                    <option value="Entrée" <%= typeof recette !== 'undefined' && recette.category === 'Entrée' ? 'selected' : '' %>>Entrée</option>
                                    <option value="Plat principal" <%= typeof recette !== 'undefined' && recette.category === 'Plat principal' ? 'selected' : '' %>>Plat principal</option>
                                    <option value="Dessert" <%= typeof recette !== 'undefined' && recette.category === 'Dessert' ? 'selected' : '' %>>Dessert</option>
                                    <option value="Boisson" <%= typeof recette !== 'undefined' && recette.category === 'Boisson' ? 'selected' : '' %>>Boisson</option>
                                    <option value="Accompagnement" <%= typeof recette !== 'undefined' && recette.category === 'Accompagnement' ? 'selected' : '' %>>Accompagnement</option>
                                </select>
                            </div>

                            <div>
                                <label for="origin" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Origine</label>
                                <select id="origin" name="origin" required class="cursor-pointer w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                    <option value="">Sélectionnez l'origine</option>
                                    <option value="Martinique" <%= typeof recette !== 'undefined' && recette.origin === 'Martinique' ? 'selected' : '' %>>Martinique</option>
                                    <option value="Guadeloupe" <%= typeof recette !== 'undefined' && recette.origin === 'Guadeloupe' ? 'selected' : '' %>>Guadeloupe</option>
                                    <option value="Réunion" <%= typeof recette !== 'undefined' && recette.origin === 'Réunion' ? 'selected' : '' %>>Réunion</option>
                                    <option value="Guyane" <%= typeof recette !== 'undefined' && recette.origin === 'Guyane' ? 'selected' : '' %>>Guyane</option>
                                    <option value="Haïti" <%= typeof recette !== 'undefined' && recette.origin === 'Haïti' ? 'selected' : '' %>>Haïti</option>
                                    <option value="Autre" <%= typeof recette !== 'undefined' && recette.origin === 'Autre' ? 'selected' : '' %>>Autre</option>
                                </select>
                            </div>

                            <div>
                                <label for="difficulty" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Difficulté</label>
                                <select id="difficulty" name="difficulty" required class="cursor-pointer w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                    <option value="facile" <%= typeof recette !== 'undefined' && recette.difficulty === 'facile' ? 'selected' : '' %>>Facile</option>
                                    <option value="moyen" <%= typeof recette !== 'undefined' && recette.difficulty === 'moyen' ? 'selected' : '' %>>Moyen</option>
                                    <option value="difficile" <%= typeof recette !== 'undefined' && recette.difficulty === 'difficile' ? 'selected' : '' %>>Difficile</option>
                                </select>
                            </div>

                            <div>
                                <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Options</label>
                                <div class="flex flex-wrap gap-2">
                                    <label class="inline-flex items-center">
                                        <input type="checkbox" id="isSpicyCheckbox" name="isSpicy" <%= typeof recette !== 'undefined' && recette.isSpicy ? 'checked' : '' %> class="cursor-pointer form-checkbox h-4 w-4 text-red-600 rounded">
                                        <span class="ml-2 px-2.5 py-0.5 text-xs font-medium bg-red-100 text-red-800 rounded dark:bg-red-900 dark:text-red-300">Épicé 🌶️</span>
                                    </label>
                                    <label class="inline-flex items-center">
                                        <input type="checkbox" id="isVegetarianCheckbox" name="isVegetarian" <%= typeof recette !== 'undefined' && recette.isVegetarian ? 'checked' : '' %> class="cursor-pointer form-checkbox h-4 w-4 text-blue-600 rounded">
                                        <span class="ml-2 px-2.5 py-0.5 text-xs font-medium bg-blue-100 text-blue-800 rounded dark:bg-blue-900 dark:text-blue-300">Végétarien 🌱</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section Temps et portions -->
                    <div class="grid gap-6 grid-cols-1 lg:grid-cols-3 mt-6">
                        <div>
                            <label for="preparationTime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Temps de préparation (min)</label>
                            <input 
                                type="number" 
                                id="preparationTime" 
                                name="preparationTime" 
                                min="0"
                                placeholder="0"
                                value="<%= typeof recette !== 'undefined' ? recette.preparationTime : '' %>"
                                class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                            >
                        </div>

                        <div>
                            <label for="cookingTime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Temps de cuisson (min)</label>
                            <input 
                                type="number" 
                                id="cookingTime" 
                                name="cookingTime" 
                                min="0"
                                placeholder="0"
                                value="<%= typeof recette !== 'undefined' ? recette.cookingTime : '' %>"
                                class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                            >
                        </div>

                        <div>
                            <label for="servings" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Nombre de portions</label>
                            <input 
                                type="number" 
                                id="servings" 
                                name="servings" 
                                min="1" 
                                value="<%= typeof recette !== 'undefined' ? recette.servings : '1' %>"
                                class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                            >
                        </div>
                    </div>

                    <!-- Section Description -->
                    <div class="mt-6">
                        <label for="description" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Description</label>
                        <textarea 
                            id="description" 
                            name="description" 
                            required 
                            placeholder="Décrivez la recette..."
                            rows="3"
                            class="w-full block p-2.5 text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                        ><%= typeof recette !== 'undefined' ? recette.description : '' %></textarea>
                    </div>

                    <!-- Section Ingrédients -->
                    <div class="mt-6">
                        <label for="ingredients" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Ingrédients</label>
                        <div id="ingredientsContainer" class="space-y-2">
                            <% if (typeof recette !== 'undefined' && recette.ingredients && recette.ingredients.length) { %>
                                <% recette.ingredients.forEach(function(ingredient, idx) { %>
                                    <div class="flex gap-2 ingredient-input">
                                        <input 
                                            type="text" 
                                            name="ingredients[]" 
                                            required 
                                            placeholder="Entrez un ingrédient"
                                            value="<%= ingredient %>"
                                            class="flex-1 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                        >
                                        <% if (idx > 0) { %>
                                            <button type="button" onclick="this.parentElement.remove()" class="px-3 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                                </svg>
                                            </button>
                                        <% } %>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="flex gap-2 ingredient-input">
                                    <input 
                                        type="text" 
                                        name="ingredients[]" 
                                        required 
                                        placeholder="Entrez un ingrédient"
                                        class="flex-1 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                    >
                                </div>
                            <% } %>
                        </div>
                        <button type="button" onclick="addIngredient()" class="btn-hover-effect cursor-pointer mt-3 inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors text-sm font-medium">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                            </svg>
                            Ajouter un ingrédient
                        </button>
                    </div>

                    <!-- Section Instructions -->
                    <div class="mt-6">
                        <label for="instructions" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Instructions</label>
                        <div id="instructionsContainer" class="space-y-2">
                            <% if (typeof recette !== 'undefined' && recette.instructions && recette.instructions.length) { %>
                                <% recette.instructions.forEach(function(instruction, idx) { %>
                                    <div class="flex gap-2 instruction-input">
                                        <span class="flex-shrink-0 w-8 h-8 bg-blue-100 text-blue-800 rounded-full flex items-center justify-center text-sm font-medium"><%= idx + 1 %></span>
                                        <textarea 
                                            name="instructions[]" 
                                            required 
                                            placeholder="Décrivez cette étape..."
                                            rows="2"
                                            class="flex-1 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                        ><%= instruction %></textarea>
                                        <% if (idx > 0) { %>
                                            <button type="button" onclick="removeInstruction(this)" class="px-3 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors self-start">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                                </svg>
                                            </button>
                                        <% } %>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="flex gap-2 instruction-input">
                                    <span class="flex-shrink-0 w-8 h-8 bg-blue-100 text-blue-800 rounded-full flex items-center justify-center text-sm font-medium">1</span>
                                    <textarea 
                                        name="instructions[]" 
                                        required 
                                        placeholder="Décrivez cette étape..."
                                        rows="2"
                                        class="flex-1 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                    ></textarea>
                                </div>
                            <% } %>
                        </div>
                        <button type="button" onclick="addInstruction()" class="btn-hover-effect cursor-pointer mt-3 inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors text-sm font-medium">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                            </svg>
                            Ajouter une étape
                        </button>
                    </div>

                    <!-- Boutons d'action -->
                    <div class="flex gap-4 mt-8 pt-6 border-t border-gray-200 dark:border-gray-600">
                        <button type="submit" 
                                class="btn-hover-effect cursor-pointer flex-1 inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-3 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-500 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 transition-colors">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                            </svg>
                            Ajouter la recette
                        </button>
                        <a href="/recettes/admin" 
                           class="btn-hover-effect flex-1 inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white dark:focus:ring-gray-700 transition-colors">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    // Fonctions utilitaires réutilisables
    function previewImageHandler(event, previewId, placeholderId, imgId) {
        const file = event.target.files[0];
        const preview = document.getElementById(previewId);
        const placeholder = document.getElementById(placeholderId);
        const previewImg = document.getElementById(imgId);
        
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                preview.classList.remove('hidden');
                placeholder.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        }
    }

    function addIngredientHandler(containerId) {
        const container = document.getElementById(containerId);
        const div = document.createElement('div');
        div.className = 'flex gap-2 ingredient-input';
        div.innerHTML = `
            <input 
                type="text" 
                name="ingredients[]" 
                required 
                placeholder="Entrez un ingrédient"
                class="flex-1 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            >
            <button type="button" onclick="this.parentElement.remove()" class="btn-hover-effect cursor-pointer px-3 py-2 text-white bg-red-700 rounded-lg hover:bg-red-800 focus:ring-4 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        `;
        container.appendChild(div);
    }

    function addInstructionHandler(containerId, buttonCallback) {
        const container = document.getElementById(containerId);
        const stepNumber = container.children.length + 1;
        const div = document.createElement('div');
        div.className = 'flex gap-2 instruction-input';
        div.innerHTML = `
            <span class="flex-shrink-0 w-8 h-8 bg-blue-100 text-blue-800 rounded-full flex items-center justify-center text-sm font-medium">${stepNumber}</span>
            <textarea 
                name="instructions[]" 
                required 
                placeholder="Décrivez cette étape..."
                rows="2"
                class="flex-1 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            ></textarea>
            <button type="button" onclick="${buttonCallback}(this)" class="btn-hover-effect cursor-pointer px-3 py-2 text-white bg-red-700 rounded-lg hover:bg-red-800 focus:ring-4 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        `;
        container.appendChild(div);
    }

    function updateInstructionNumbers(containerId) {
        const container = document.getElementById(containerId);
        const instructions = container.querySelectorAll('.instruction-input');
        instructions.forEach((instruction, index) => {
            const stepNumber = instruction.querySelector('span');
            if (stepNumber) {
                stepNumber.textContent = index + 1;
            }
        });
    }

    function validateRecetteForm(form) {
        const ingredients = form.querySelectorAll('input[name="ingredients[]"]');
        const instructions = form.querySelectorAll('textarea[name="instructions[]"]');
        
        let hasEmptyIngredient = false;
        let hasEmptyInstruction = false;
        
        ingredients.forEach(function(input) {
            if (input.value.trim() === '') {
                hasEmptyIngredient = true;
                input.focus();
            }
        });
        
        instructions.forEach(function(textarea) {
            if (textarea.value.trim() === '') {
                hasEmptyInstruction = true;
                textarea.focus();
            }
        });
        
        if (hasEmptyIngredient) {
            Swal.fire({
                icon: 'warning',
                title: 'Champs vides',
                text: 'Veuillez remplir tous les champs d\'ingrédients ou les supprimer s\'ils sont vides.',
                confirmButtonColor: '#3b82f6'
            });
            return false;
        } if (hasEmptyInstruction) {
            Swal.fire({
                icon: 'warning',
                title: 'Champs vides',
                text: 'Veuillez remplir toutes les étapes d\'instructions ou les supprimer si elles sont vides.',
                confirmButtonColor: '#3b82f6'
            });
            return false;
        }
        return true;
    }

    // Fonctions spécifiques pour le formulaire d'ajout
    function previewImage(event) {
        previewImageHandler(event, 'imagePreview', 'uploadPlaceholder', 'previewImg');
    }

    function addIngredient() {
        addIngredientHandler('ingredientsContainer');
    }

    function addInstruction() {
        addInstructionHandler('instructionsContainer', 'removeInstruction');
    }

    function removeInstruction(button) {
        button.parentElement.remove();
        updateInstructionNumbers('instructionsContainer');
    }

    function updateInstructionNumbers() {
        const container = document.getElementById('instructionsContainer');
        const instructions = container.querySelectorAll('.instruction-input');
        instructions.forEach((instruction, index) => {
            const stepNumber = instruction.querySelector('span');
            if (stepNumber) {
                stepNumber.textContent = index + 1;
            }
        });
    }

    // Validation du formulaire d'ajout
    document.getElementById('recetteForm').addEventListener('submit', function(e) {
        const imageInput = this.querySelector('input[name="image"]');
        if (!imageInput.files.length) {
            Swal.fire({
                icon: 'error',
                title: 'Image requise',
                text: 'Veuillez sélectionner une image pour la recette',
                confirmButtonColor: '#3b82f6'
            });
            e.preventDefault();
            return false;
        }
        
        if (!validateRecetteForm(this)) {
            e.preventDefault();
        }
    });
</script>


