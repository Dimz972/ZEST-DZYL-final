<script>


    // Ajouter un event listener pour tous les boutons de modification
    document.addEventListener('DOMContentLoaded', function() {
        const updateButtons = document.querySelectorAll('#updateModalButton');
        updateButtons.forEach(button => {
            button.addEventListener('click', function() {
                const id = this.dataset.id;
                const name = this.dataset.name;
                const description = this.dataset.description;
                const category = this.dataset.category;
                const origin = this.dataset.origin;
                const preparationTime = this.dataset.preparationtime;
                const cookingTime = this.dataset.cookingtime;
                const servings = this.dataset.servings;
                const difficulty = this.dataset.difficulty;
                const isSpicy = this.dataset.spicy === 'true';
                const isVegetarian = this.dataset.vegetarian === 'true';
                const ingredients = this.dataset.ingredients;
                const instructions = this.dataset.instructions;
                
                openUpdateModal(id, name, description, category, origin, preparationTime, cookingTime, servings, difficulty, isSpicy, isVegetarian, ingredients, instructions);
            });
        });
    });

    function openUpdateModal(id, name, description, category, origin, preparationTime, cookingTime, servings, difficulty, isSpicy, isVegetarian, ingredients, instructions) {
        document.getElementById('updateForm').action = `/recettes/update/${id}`;
        document.getElementById('updateName').value = name;
        document.getElementById('updateDescription').value = description;
        document.getElementById('updateCategory').value = category;
        document.getElementById('updateOrigin').value = origin;
        document.getElementById('updatePreparationTime').value = preparationTime;
        document.getElementById('updateCookingTime').value = cookingTime;
        document.getElementById('updateServings').value = servings;
        document.getElementById('updateDifficulty').value = difficulty;
        document.getElementById('updateIsSpicy').checked = isSpicy;
        document.getElementById('updateIsVegetarian').checked = isVegetarian;
        
        // Gérer les ingrédients
        const ingredientsContainer = document.getElementById('updateIngredientsContainer');
        ingredientsContainer.innerHTML = ''; // Vider le conteneur
        
        const ingredientsArray = ingredients.split(', ').filter(i => i.trim() !== '');
        ingredientsArray.forEach((ingredient, index) => {
            const newIngredient = document.createElement('div');
            newIngredient.className = 'flex gap-2 ingredient-input';
            newIngredient.innerHTML = `
                <input 
                    type="text" 
                    name="ingredients[]" 
                    required 
                    placeholder="Nom de l'ingrédient"
                    value="${ingredient.trim()}"
                    class="flex-1 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                >
                ${index > 0 ? `
                <button type="button" onclick="this.parentElement.remove()" class="btn-hover-effect cursor-pointer px-3 py-2 text-white bg-red-700 rounded-lg hover:bg-red-800 focus:ring-4 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
                ` : ''}
            `;
            ingredientsContainer.appendChild(newIngredient);
        });

        // Gérer les instructions
        const instructionsContainer = document.getElementById('updateInstructionsContainer');
        instructionsContainer.innerHTML = ''; // Vider le conteneur
        
        const instructionsArray = instructions.split('|||').filter(i => i.trim() !== '');
        instructionsArray.forEach((instruction, index) => {
            const newInstruction = document.createElement('div');
            newInstruction.className = 'flex gap-2 instruction-input';
            newInstruction.innerHTML = `
                <span class="flex-shrink-0 w-8 h-8 bg-blue-100 text-blue-800 rounded-full flex items-center justify-center text-sm font-medium">${index + 1}</span>
                <textarea 
                    name="instructions[]" 
                    required 
                    placeholder="Décrivez cette étape..."
                    rows="2"
                    class="flex-1 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                >${instruction.trim()}</textarea>
                ${index > 0 ? `
                <button type="button" onclick="removeUpdateInstruction(this)" class="btn-hover-effect cursor-pointer px-3 py-2 text-white bg-red-700 rounded-lg hover:bg-red-800 focus:ring-4 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800 self-start">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
                ` : ''}
            `;
            instructionsContainer.appendChild(newInstruction);
        });
        
        // Réinitialiser l'aperçu de l'image
        document.getElementById('updateImagePreview').classList.add('hidden');
        document.getElementById('updateUploadPlaceholder').classList.remove('hidden');
        document.getElementById('updateImage').value = '';
        
        document.getElementById('updateModal').classList.remove('hidden');
    }

    function closeUpdateModal() {
        document.getElementById('updateModal').classList.add('hidden');
    }

    // Fonctions spécifiques pour le formulaire de modification
    function previewUpdateImage(event) {
        previewImageHandler(event, 'updateImagePreview', 'updateUploadPlaceholder', 'updatePreviewImg');
    }

    function addUpdateIngredient() {
        addIngredientHandler('updateIngredientsContainer');
    }

    function addUpdateInstruction() {
        addInstructionHandler('updateInstructionsContainer', 'removeUpdateInstruction');
    }

    function removeUpdateInstruction(button) {
        button.parentElement.remove();
        updateInstructionNumbers('updateInstructionsContainer');
    }

    function updateUpdateInstructionNumbers() {
        updateInstructionNumbers('updateInstructionsContainer');
    }

    // Fermer le modal en cliquant à l'extérieur
    document.getElementById('updateModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeUpdateModal();
        }
    });

    // Validation du formulaire de modification
    document.getElementById('updateForm').addEventListener('submit', function(e) {
        if (!validateRecetteForm(this)) {
            e.preventDefault();
        }
    });

// Fonction de confirmation de suppression avec SweetAlert2
function confirmDelete(event, itemType) {
    event.preventDefault();
    Swal.fire({
        title: 'Êtes-vous sûr ?',
        text: `Voulez-vous vraiment supprimer cette ${itemType} ?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Oui, supprimer',
        cancelButtonText: 'Annuler'
    }).then((result) => {
        if (result.isConfirmed) {
            event.target.submit();
        }
    });
    return false;
}
</script>

