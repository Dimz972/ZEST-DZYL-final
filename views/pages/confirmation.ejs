<section class="bg-gray-50 py-8 antialiased dark:bg-gray-900 md:py-12">
  <div class="mx-auto max-w-screen-xl px-4 2xl:px-0">
    <div class="max-w-4xl mx-auto">
      <!-- Success Card -->
      <div class="bg-white rounded-lg shadow-md dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-8 text-center mb-6">
        <div class="w-16 h-16 rounded-full bg-green-100 dark:bg-green-900 p-3 flex items-center justify-center mx-auto mb-4">
          <svg
            aria-hidden="true"
            class="w-10 h-10 text-green-500 dark:text-green-400"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <span class="sr-only">Success</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
          Commande confirmée avec succès !
        </h1>
        <p class="text-gray-600 dark:text-gray-400 mb-6">
          Votre commande a bien été enregistrée et sera traitée dans les plus brefs délais.
        </p>
      </div>

      <!-- Order Summary Card -->
      <div class="bg-white rounded-lg shadow-md dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-6 mb-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Résumé de votre commande
        </h2>
        <div class="space-y-3">
          <% if (orderSummary && Array.isArray(orderSummary.cart) && orderSummary.cart.length > 0) { %>
            <% orderSummary.cart.forEach(function(item) { %>
              <% 
                // Déterminer si c'est un plat ou un article
                const isPlat = item.plat !== undefined;
                const isArticle = item.article !== undefined;
                const currentItem = isPlat ? item.plat : item.article;
                const itemType = isPlat ? 'plat' : 'article';
              %>
              <% if (currentItem) { %>
                <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                  <div class="flex items-center space-x-3">
                    <div>
                      <h4 class="font-medium text-gray-900 dark:text-white">
                        <%= currentItem.name %>
                        <span class="text-xs px-2 py-1 rounded <%= isPlat ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300' : 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300' %> ml-2">
                          <%= isPlat ? 'Plat' : 'Article' %>
                        </span>
                      </h4>
                      <p class="text-sm text-gray-600 dark:text-gray-400">
                        Quantité : <%= item.quantity %> × <%= currentItem.price %> €
                      </p>
                    </div>
                  </div>
                  <div class="text-right">
                    <span class="font-medium text-gray-900 dark:text-white">
                      <%= (currentItem.price * item.quantity).toFixed(2) %> €
                    </span>
                  </div>
                </div>
              <% } %>
            <% }); %>
          <% } else { %>
            <div class="text-center py-4 text-gray-500 dark:text-gray-400">
              Aucun article dans la commande.
            </div>
          <% } %>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-600">
          <div class="flex justify-between items-center">
            <span class="text-lg font-semibold text-gray-900 dark:text-white">Total :</span>
            <span class="text-xl font-bold text-green-600 dark:text-green-400">
              <%= orderSummary.total.toFixed(2) %> €
            </span>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="btn-hover-effect cursor-pointer inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 transition-colors"
        >
          Retour à l'accueil
        </a>
        <!-- <a
          href="/plats"
          class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-gray-900 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-700 transition-colors"
        >
          Commander à nouveau
        </a> -->
      </div>
    </div>
  </div>
</section>
