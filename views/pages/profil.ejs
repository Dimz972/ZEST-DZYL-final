<section class="bg-gray-50 py-8 antialiased dark:bg-gray-900 md:py-16">
    <div class="mx-auto max-w-screen-xl px-4 2xl:px-0">
        <div class="mx-auto max-w-4xl">
            <div class="mb-8 text-center">
                <h1 class="text-2xl font-bold text-gray-900 sm:text-4xl dark:text-white">
                    Mon Profil
                </h1>
                <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
                    Gérez vos informations personnelles et vos préférences
                </p>
            </div>

            <!-- Informations utilisateur -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 dark:bg-gray-800 dark:border-gray-700 p-6 mb-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-semibold text-gray-900 dark:text-white">
                        Informations personnelles
                    </h2>
                    <!-- Boutons d'action -->
                    <div class="flex gap-2">
                        <button id="editProfileModalBtn" title="Modifier mon profil" data-modal-target="editProfileModal" data-modal-toggle="editProfileModal" class="btn-hover-effect cursor-pointer inline-flex items-center justify-center p-2 text-sm font-medium text-white bg-blue-700 border border-transparent rounded-lg hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                        </button>
                        <form action="/logout" method="GET" style="display: inline;">
                            <button type="submit" title="Se déconnecter" class="btn-hover-effect cursor-pointer inline-flex items-center justify-center p-2 text-sm font-medium text-white bg-red-700 rounded-lg hover:bg-red-800 focus:ring-4 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                </svg>
                            </button>
                        </form>
                          <form action="/users/deleteAccount/<%= user._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est irréversible.')">
                            <button type="submit" title="Supprimer mon compte" class="btn-hover-effect cursor-pointer inline-flex items-center justify-center p-2 text-sm font-medium text-white bg-red-700 rounded-lg hover:bg-red-800 focus:ring-4 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800">
                               <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                              </svg>
                            </button>
                          </form>
                    </div>
                 </div>

                <!-- Affichage des informations -->
                <div id="profileInfo" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                                Prénom
                            </label>
                            <p class="text-lg text-gray-900 dark:text-white">
                                <%= user.fname %>
                            </p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                                Nom
                            </label>
                            <p class="text-lg text-gray-900 dark:text-white">
                                <%= user.lname %>
                            </p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                                Email
                            </label>
                            <p class="text-lg text-gray-900 dark:text-white">
                                <%= user.email %>
                            </p>
                        </div>
                    </div>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                                Téléphone
                            </label>
                            <p class="text-lg text-gray-900 dark:text-white">
                                <%= user.phone_number || 'Non renseigné' %>
                            </p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                                Adresse
                            </label>
                            <p class="text-lg text-gray-900 dark:text-white">
                                <%= user.adresse || 'Non renseignée' %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal de modification du profil -->
<div id="editProfileModal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 flex justify-center items-center w-full md:inset-0 h-modal md:h-full bg-black bg-opacity-60">
    <div class="relative p-4 w-full max-w-4xl h-full md:h-auto">
        <!-- Modal content -->
        <div class="relative p-4 bg-white rounded-lg shadow dark:bg-gray-800 sm:p-5 max-w-4xl mx-auto w-full">
            <!-- Modal header -->
            <div class="relative flex items-center justify-center mb-4 rounded-t">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white text-center">
                    Modifier mon profil
                </h2>
                <button type="button" class="btn-hover-effect cursor-pointer absolute right-0 text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 inline-flex items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="editProfileModal">
                    <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="sr-only">Fermer le modal</span>
                </button>
            </div>

            <!-- Modal body -->
            <div class="space-y-6 max-h-[70vh] overflow-y-auto">
                <form id="updateProfileForm" action="/users/updateProfile/<%= user._id %>" method="POST" class="space-y-6">
                    <!-- Informations principales -->
                    <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-4">
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            Informations personnelles
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="modal_fname" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                                    Prénom <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="modal_fname" name="fname" value="<%= user.fname %>" required 
                                       class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                            </div>
                            <div>
                                <label for="modal_lname" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                                    Nom <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="modal_lname" name="lname" value="<%= user.lname %>" required 
                                       class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                            </div>
                            <div>
                                <label for="modal_email" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                                    Email <span class="text-red-500">*</span>
                                </label>
                                <input type="email" id="modal_email" name="email" value="<%= user.email %>" required 
                                       class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                            </div>
                            <div>
                                <label for="modal_phone" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                                    Téléphone
                                </label>
                                <input type="text" id="modal_phone" name="phone_number" value="<%= user.phone_number %>" 
                                       class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                       placeholder="Votre numéro de téléphone">
                            </div>
                        </div>
                        <div class="mt-4">
                            <label for="modal_adresse" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                                Adresse
                            </label>
                            <input type="text" id="modal_adresse" name="adresse" value="<%= user.adresse %>" 
                                   class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                   placeholder="Votre adresse complète">
                        </div>
                    </div>
                    
                    <!-- Section mot de passe -->
                    <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-4">
                        <h3 class="text-lg font-semibold text-amber-800 dark:text-amber-400 mb-4 flex items-center">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                            Changer le mot de passe (optionnel)
                        </h3>
                        <p class="text-sm text-amber-700 dark:text-amber-300 mb-4">
                            Laissez ces champs vides si vous ne souhaitez pas modifier votre mot de passe.
                        </p>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="password" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                                    Nouveau mot de passe
                                </label>
                                <input type="password" id="password" name="password" 
                                       placeholder="Nouveau mot de passe" 
                                       class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                <!-- Indicateurs de validation du mot de passe -->
                                <div id="passwordValidation" class="mt-2 space-y-1 text-xs" style="display: none;">
                                    <p id="contient" class="text-red-600 dark:text-red-400">• Le mot de passe doit contenir au moins 8 caractères</p>
                                    <p id="maj" class="text-red-600 dark:text-red-400">• Le mot de passe doit contenir au moins une majuscule</p>
                                    <p id="spe" class="text-red-600 dark:text-red-400">• Le mot de passe doit contenir au moins un caractère spécial</p>
                                    <p id="num" class="text-red-600 dark:text-red-400">• Le mot de passe doit contenir au moins un chiffre</p>
                                </div>
                            </div>
                            <div>
                                <label for="confirmPassword" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                                    Confirmer le nouveau mot de passe
                                </label>
                                <input type="password" id="confirmPassword" name="confirmPassword" 
                                       placeholder="Confirmez votre nouveau mot de passe" 
                                       class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                <!-- Indicateur de correspondance des mots de passe -->
                                <div id="passwordMatchValidation" class="mt-2" style="display: none;">
                                    <p id="ver" class="text-xs text-red-600 dark:text-red-400">• Les mots de passe ne correspondent pas</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" name="_method" value="PUT">
                    
                    <!-- Modal footer -->
                    <div class="flex items-center justify-end space-x-4 pt-4 border-t border-gray-200 dark:border-gray-600 mb-2">
                        <button type="submit" class="btn-hover-effect cursor-pointer flex-1 inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-3 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 transition-colors">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Enregistrer les modifications
                        </button>
                        <button type="button" data-modal-hide="editProfileModal" class="btn-hover-effect cursor-pointer flex-1 inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white dark:focus:ring-gray-700 transition-colors">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                            Annuler
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
  
        // Réinitialiser le formulaire quand le modal se ferme
        const modal = document.getElementById('editProfileModal');
        if (modal) {
            const passwordField = document.getElementById('password');
            const confirmPasswordField = document.getElementById('confirmPassword');
            const passwordValidation = document.getElementById('passwordValidation');
            const passwordMatchValidation = document.getElementById('passwordMatchValidation');
            
            modal.addEventListener('hidden.bs.modal', function () {
                // Remettre à zéro les champs de mot de passe et leurs validations
                if (passwordField) passwordField.value = '';
                if (confirmPasswordField) confirmPasswordField.value = '';
                if (passwordValidation) passwordValidation.style.display = 'none';
                if (passwordMatchValidation) passwordMatchValidation.style.display = 'none';
                
                // Remettre les textes et couleurs par défaut pour tous les indicateurs
                const indicators = ['contient', 'maj', 'spe', 'num', 'ver'];
                const defaultMessages = [
                    'Le mot de passe doit contenir au moins 8 caractères !',
                    'Le mot de passe doit contenir au moins une majuscule !',
                    'Le mot de passe doit contenir au moins un caractère spécial !',
                    'Le mot de passe doit contenir au moins un chiffre !',
                    'Les mots de passe ne correspondent pas !'
                ];
                
                indicators.forEach((id, index) => {
                    const element = document.getElementById(id);
                    if (element) {
                        element.style.color = 'red';
                        element.className = 'text-xs text-red-600 dark:text-red-400';
                        element.textContent = defaultMessages[index];
                    }
                });
            });
        }
    });
</script> 

  