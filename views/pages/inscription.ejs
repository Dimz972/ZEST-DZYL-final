<section class="bg-gray-50 dark:bg-gray-900">
  <div
    class="flex flex-col items-center justify-start px-6 mt-2 mb-6 mx-auto lg:py-0"
  >
    <a
      href="/"
      class="flex items-center mb-6 text-3xl font-bold text-gray-900 dark:text-white"
    >
      <img
        class="w-16 h-16 mr-2 rounded-full"
        src="/logo zet d'zyl.png"
        alt="logo"
      />
      ZEST' D'ZYL
    </a>
    <div
      class="slide-up w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700"
    >
      <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
        <h1
          class="text-center text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white"
        >
          Créer un compte
        </h1>
        <% if (typeof message !== 'undefined' && message) { %>
            <% if (messageType === 'success') { %>
              <div class="p-4 mb-4 text-sm text-center text-green-800 rounded-lg bg-green-50 dark:bg-gray-800 dark:text-green-400" role="alert">
                 <%= message %>
              </div>
            <% } else { %>
              <div class="p-4 mb-4 text-sm text-center text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400" role="alert">
                <%= message %>
              </div>
            <% } %>
          <% } %>
        <form
          class="space-y-4 md:space-y-6"
          action="/users/add"
          method="POST"
          id="userForm"
        >
          <div>
            <label
              for="fname"
              class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
              >Prénom
            </label>
            <input
              type="text"
              id="fname"
              name="fname"
              required
              placeholder="Entrez votre prénom"
              value="<%= formData && formData.fname ? formData.fname : '' %>"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            />
          </div>
          <div>
            <label
              for="lname"
              class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
              >Nom de famille
            </label>
            <input
              type="text"
              id="lname"
              name="lname"
              required
              placeholder="Entrez votre nom de famille"
              value="<%= formData && formData.lname ? formData.lname : '' %>"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            />
          </div>
          <div>
            <label
              for="email"
              class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
              >Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="nom@hotmail.fr"
              value="<%= formData && formData.email ? formData.email : '' %>"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            />
          </div>
          <div>
            <label
              for="phone_number"
              class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
              >Numéro de téléphone
            </label>
            <input
              type="tel"
              id="phone_number"
              name="phone_number"
              required
              placeholder="0123456789"
              pattern="[0-9]{10}"
              value="<%= formData && formData.phone_number ? formData.phone_number : '' %>"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            />
          </div>
          <div>
            <label
              for="adresse"
              class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
              >Adresse
            </label>
            <textarea
              id="adresse"
              name="adresse"
              required
              placeholder="Entrez votre adresse complète"
              rows="3"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            ><%= formData && formData.adresse ? formData.adresse : '' %></textarea
            >
          </div>
          <div>
            <label
              for="password"
              class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
              >Mot de passe
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder="Entrez votre mot de passe"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            />
            <!-- Indicateurs de validation du mot de passe -->
            <div class="mt-2 space-y-1 text-xs">
              <p id="contient" class="text-red-600 dark:text-red-400">Le mot de passe doit contenir au moins 8 caractères !</p>
              <p id="maj" class="text-red-600 dark:text-red-400">Le mot de passe doit contenir au moins une majuscule !</p>
              <p id="spe" class="text-red-600 dark:text-red-400">Le mot de passe doit contenir au moins un caractère spécial !</p>
              <p id="num" class="text-red-600 dark:text-red-400">Le mot de passe doit contenir au moins un chiffre !</p>
            </div>
          </div>
          <div>
            <label
              for="confirmPassword"
              class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
              >Confirmer le mot de passe
            </label>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              required
              placeholder="Confirmez votre mot de passe"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            />
            <!-- Indicateur de correspondance des mots de passe -->
            <div class="mt-2">
              <p id="ver" class="text-xs text-red-600 dark:text-red-400">Les mots de passe ne correspondent pas !</p>
            </div>
          </div>
          <button
            type="submit"
            class="btn-hover-effect cursor-pointer w-full text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
          >
            Créer le compte
          </button>
          <p class="text-center text-sm font-light text-gray-500 dark:text-gray-400">
            Vous avez déjà un compte ?
            <a
              href="/users/login"
              class="cursor-pointer font-medium text-primary-600 hover:underline dark:text-primary-500"
            >
              Connectez-vous ici</a
            >
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
