<section class="bg-gray-50 py-8 antialiased dark:bg-gray-900 md:py-12">
  <div class="mx-auto max-w-screen-xl px-4 2xl:px-0">
    <h1 class="text-3xl font-bold text-center mb-8 text-green-600">Commande en cours</h1>
    
    <div class="bg-white rounded-lg shadow-lg overflow-hidden p-8">
      <% if (orderSummary) { %>
      <div class="grid md:grid-cols-2 gap-6 mb-6">
        <div class="space-y-4">
          <h2 class="text-xl font-semibold text-gray-800">Informations de commande</h2>
          <div class="bg-gray-50 rounded-lg p-4 space-y-2">
            <p class="text-gray-700">
              <strong class="text-gray-900">Date de commande :</strong>
              <%= orderSummary.orderDisplayDate %>
            </p>
            <p class="text-gray-700">
              <strong class="text-gray-900">Heure de commande :</strong>
              <%= orderSummary.orderDisplayTime %>
            </p>
            <p class="text-gray-700"><strong class="text-gray-900">Prénom et nom :</strong> <%= orderSummary.name %></p>
            <p class="text-gray-700">
              <strong class="text-gray-900">Mode de livraison :</strong> <%= orderSummary.deliveryMethod ===
              'delivery' ? 'Livraison à domicile' : 'À emporter' %>
            </p>
            <% if (orderSummary.deliveryMethod === 'delivery') { %>
            <p class="text-gray-700"><strong class="text-gray-900">Adresse :</strong> <%= orderSummary.address %></p>
            <% } %>
            <p class="text-gray-700"><strong class="text-gray-900">Téléphone :</strong> <%= orderSummary.phone %></p>
            <% if (orderSummary.methodePaiement) { %>
            <p class="text-gray-700">
              <strong class="text-gray-900">Méthode de paiement :</strong> 
              <%= orderSummary.methodePaiement === 'card' ? 'Carte bancaire' : 'Espèces' %>
            </p>
            <% } %>
            <% if (orderSummary.notes) { %>
            <p class="text-gray-700"><strong class="text-gray-900">Instructions :</strong> <%= orderSummary.notes %></p>
            <% } %>
          </div>
        </div>
        
        <div class="space-y-4">
          <h2 class="text-xl font-semibold text-gray-800">Articles commandés</h2>
          <div class="bg-gray-50 rounded-lg p-4">
            <% if (orderSummary.cart && orderSummary.cart.length > 0) { %> 
              <div class="space-y-3">
                <% orderSummary.cart.forEach(function(item) { %>
                <% 
                  // Déterminer si c'est un plat ou un article
                  const isPlat = item.plat !== undefined;
                  const isArticle = item.article !== undefined;
                  const currentItem = isPlat ? item.plat : item.article;
                  const itemType = isPlat ? 'plat' : 'article';
                %>
                <% if (currentItem) { %>
                <div class="flex justify-between items-center p-3 bg-white rounded-lg shadow-sm">
                  <div class="flex items-center space-x-3">
                    <span class="text-gray-800 font-medium"><%= currentItem.name %></span>
                    <span class="rounded px-2.5 py-0.5 text-xs font-medium <%= isPlat ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %>">
                      <%= isPlat ? 'Plat' : 'Article' %>
                    </span>
                  </div>
                  <div class="text-right">
                    <div class="text-gray-600 text-sm"><%= item.quantity %> x <%= currentItem.price %> €</div>
                    <div class="text-gray-900 font-semibold"><%= (currentItem.price * item.quantity).toFixed(2) %> €</div>
                  </div>
                </div>
                <% } %>
                <% }); %>
              </div>
            <% } else { %>
              <p class="text-gray-500 text-center py-4">Aucun article dans cette commande.</p>
            <% } %>
            
            <div class="mt-4 pt-4 border-t border-gray-200">
              <div class="flex justify-between items-center">
                <span class="text-lg font-semibold text-gray-900">Total :</span>
                <span class="text-xl font-bold text-green-600"><%= orderSummary.total.toFixed(2) %> €</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <form action="/commande/annuler" method="POST" class="inline-block">
          <input type="hidden" name="orderId" value="<%= orderSummary._id %>">
          <button
            type="submit"
            class="w-full sm:w-auto px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium"
          >
            Annuler la commande
          </button>
        </form>
         <a
          href="/"
          class="w-full sm:w-auto px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors font-medium text-center"
        >
          Retour à l'accueil
        </a>
      </div>

      <% } else { %>
        <div class="text-center py-12">
          <div class="mb-6">
            <span class="text-6xl">🍛</span>
          </div>
          <h2 class="text-2xl font-semibold text-gray-600 mb-4">Aucune commande en cours</h2>
          <p class="text-gray-500 mb-6">Vous n'avez pas de commande en cours pour le moment.</p>
          <a
            href="/plats"
            class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium"
          >
            Voir nos plats
          </a>
        </div>
      <% } %>
    </div>
  </div>
</section>
