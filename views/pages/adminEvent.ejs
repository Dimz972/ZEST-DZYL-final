<script>
// Gérer les clics sur les boutons de mise à jour
document.addEventListener('DOMContentLoaded', function() {
    const updateButtons = document.querySelectorAll('#updateModalButton');
    updateButtons.forEach(button => {
        button.addEventListener('click', function() {
            const id = this.dataset.id;
            const title = this.dataset.title;
            const description = this.dataset.description;
            const date = this.dataset.date;
            const startTime = this.dataset.starttime;
            const endTime = this.dataset.endtime;
            const location = this.dataset.location;
            const capacity = this.dataset.capacity;
            const price = this.dataset.price;
            const badge = this.dataset.badge;

            openUpdateModal(id, title, description, date, startTime, endTime, location, capacity, price, badge);
        });
    });
});

function openUpdateModal(id, title, description, date, startTime, endTime, location, capacity, price, badge) {
    // Remplir les champs du formulaire
    document.getElementById('updateTitle').value = title;
    document.getElementById('updateDescription').value = description;
    document.getElementById('updateDate').value = date;
    document.getElementById('updateStartTime').value = startTime;
    document.getElementById('updateEndTime').value = endTime;
    document.getElementById('updateLocation').value = location;
    document.getElementById('updateCapacity').value = capacity;
    document.getElementById('updatePrice').value = price;
    document.getElementById('updateBadge').value = badge || '';

    // Définir l'action du formulaire
    document.getElementById('updateForm').action = `/events/update/${id}`;

    // Configurer les validations pour le formulaire de modification
    const updateStartTime = document.getElementById('updateStartTime');
    const updateEndTime = document.getElementById('updateEndTime');
    const updateDate = document.getElementById('updateDate');
    
    // Empêcher de sélectionner une date passée
    const today = new Date().toISOString().split('T')[0];
    updateDate.setAttribute('min', today);
    
    function validateUpdateTimes() {
        validateEventTimes('updateStartTime', 'updateEndTime');
    }
    
    // Supprimer les anciens event listeners pour éviter les duplications
    updateStartTime.removeEventListener('change', validateUpdateTimes);
    updateEndTime.removeEventListener('change', validateUpdateTimes);
    
    // Ajouter les nouveaux event listeners
    updateStartTime.addEventListener('change', validateUpdateTimes);
    updateEndTime.addEventListener('change', validateUpdateTimes);

    // Réinitialiser l'aperçu de l'image
    document.getElementById('updateImagePreview').classList.add('hidden');
    document.getElementById('updateUploadPlaceholder').classList.remove('hidden');
    document.getElementById('updateImage').value = '';

    // Afficher le modal
    document.getElementById('updateModal').classList.remove('hidden');
}

function closeUpdateModal() {
    document.getElementById('updateModal').classList.add('hidden');
}

// Fonctions spécifiques pour le formulaire de modification
function previewUpdateImage(event) {
    previewImageHandler(event, 'updateImagePreview', 'updateUploadPlaceholder', 'updatePreviewImg');
}

// Fermer le modal en cliquant à l'extérieur
document.getElementById('updateModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeUpdateModal();
    }
});

// Validation du formulaire de modification
document.getElementById('updateForm').addEventListener('submit', function(e) {
    if (!validateEventForm(this, false)) {
        e.preventDefault();
    }
});

// Gérer les boutons de visualisation des participants
document.addEventListener('DOMContentLoaded', function() {
    const viewParticipantsButtons = document.querySelectorAll('.view-participants-btn');
    
    viewParticipantsButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            
            const eventId = this.getAttribute('data-event-id');
            const eventTitle = this.getAttribute('data-event-title');
            const participantsCount = this.getAttribute('data-event-participants');
            
            // Charger les données des participants
            loadParticipants(eventId, eventTitle, participantsCount);
        });
    });
});

// Fonction pour charger les participants d'un événement
async function loadParticipants(eventId, eventTitle, participantsCount) {
    try {
        // Stocker l'ID de l'événement actuel pour les actions
        window.currentEventId = eventId;
        
        // Mettre à jour le titre du drawer
        document.getElementById('drawer-event-title').textContent = eventTitle;
        document.getElementById('drawer-participants-count').textContent = participantsCount;
        
        // Afficher un loader
        const participantsList = document.getElementById('participants-list');
        participantsList.innerHTML = '<div class="text-center py-4"><div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div><p class="mt-2 text-gray-500">Chargement des participants...</p></div>';
        
        // Faire l'appel API pour récupérer les participants
        const response = await fetch(`/events/${eventId}/participants`);
        
        if (response.ok) {
            const data = await response.json();
            // Mettre à jour le compteur avec le nombre réel
            document.getElementById('drawer-participants-count').textContent = data.count;
            displayParticipants(data.participants);
        } else {
            participantsList.innerHTML = '<div class="text-center py-8"><p class="text-red-500">Erreur lors du chargement des participants</p></div>';
        }
    } catch (error) {
        console.error('Erreur:', error);
        document.getElementById('participants-list').innerHTML = '<div class="text-center py-8"><p class="text-red-500">Erreur lors du chargement des participants</p></div>';
    }
}

// Fonction pour afficher la liste des participants
function displayParticipants(participants) {
    const participantsList = document.getElementById('participants-list');
    
    if (!participants || participants.length === 0) {
        participantsList.innerHTML = `
            <div class="text-center py-12">
                <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <h3 class="mt-4 text-lg font-medium text-gray-900 dark:text-white">Aucun participant</h3>
                <p class="mt-2 text-gray-500 dark:text-gray-400">Cet événement n'a pas encore de participants inscrits.</p>
            </div>
        `;
        return;
    }
    
    let html = '<div class="space-y-3">';
    
    participants.forEach((participant, index) => {
        const registrationDate = new Date(participant.registrationDate).toLocaleDateString('fr-FR', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
        
        // Définir les styles selon le statut
        let bgClass, opacity, statusBadge, statusText, statusColor;
        
        if (participant.status === 'confirmed') {
            bgClass = 'bg-gray-50 dark:bg-gray-700';
            opacity = '';
            statusText = 'Confirmé';
            statusColor = 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300';
        } else if (participant.status === 'cancelled') {
            bgClass = 'bg-red-50 dark:bg-red-900/20';
            opacity = 'opacity-60';
            statusText = 'Annulé';
            statusColor = 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300';
        } else if (participant.status === 'mixed') {
            bgClass = 'bg-yellow-50 dark:bg-yellow-900/20';
            opacity = '';
            statusText = 'Mixte';
            statusColor = 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300';
        }

        html += `
            <div class="flex items-center p-4 ${bgClass} rounded-lg participant-item ${opacity}" data-participant-id="${participant.id}">
                <div class="ml-4 flex-1">
                    <div class="flex items-center justify-between">
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium text-gray-900 dark:text-white">
                                    ${participant.firstName || 'Prénom'} ${participant.lastName || 'Nom'}
                                </p>
                                ${participant.status === 'mixed' ? `
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        ${participant.confirmedCount} confirmé${participant.confirmedCount > 1 ? 's' : ''}
                                    </span>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        ${participant.cancelledCount} annulé${participant.cancelledCount > 1 ? 's' : ''}
                                    </span>
                                ` : `
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300">
                                        ${participant.totalCount} place${participant.totalCount > 1 ? 's' : ''}
                                    </span>
                                `}
                            </div>
                            <p class="text-sm text-gray-500 dark:text-gray-400">
                                ${participant.email || 'Email non disponible'}
                            </p>
                            ${participant.phone ? `<p class="text-xs text-gray-500 dark:text-gray-400">${participant.phone}</p>` : ''}
                            <p class="text-xs text-gray-400 mt-1">Inscrit le ${registrationDate}</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusColor}">
                                ${statusText}
                            </span>
                            <button
                                onclick="removeParticipant('${window.currentEventId}', '${participant.id}', ${participant.totalCount})"
                                class="cursor-pointer text-red-600 hover:text-red-800 p-1 rounded-lg hover:bg-red-100 dark:hover:bg-red-900"
                                title="Supprimer définitivement ce participant et toutes ses réservations"
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                    ${participant.notes ? `<p class="text-xs text-gray-500 dark:text-gray-400 mt-2 italic">"${participant.notes}"</p>` : ''}
                </div>
            </div>
        `;
    });
    
    html += '</div>';
    participantsList.innerHTML = html;
}



// Fonction pour supprimer un participant
async function removeParticipant(eventId, userId, reservationCount = 1) {
    const confirmMessage = reservationCount > 1 
        ? `Voulez-vous vraiment supprimer toutes les ${reservationCount} réservations de ce participant ?`
        : 'Voulez-vous vraiment supprimer ce participant de l\'événement ?';
    
    const result = await Swal.fire({
        title: 'Êtes-vous sûr ?',
        text: confirmMessage,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Oui, supprimer',
        cancelButtonText: 'Annuler'
    });
        
    if (!result.isConfirmed) {
        return;
    }
    
    try {
        const response = await fetch(`/events/${eventId}/participants/${userId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                numberOfPeople: reservationCount
            })
        });
        
        const data = await response.json();
        
        if (data.success) {
            // Recharger la liste des participants
            loadParticipants(eventId, document.getElementById('drawer-event-title').textContent, data.currentParticipants);
            
            // Mettre à jour le compteur dans le tableau principal
            const tableRow = document.querySelector(`[data-id="${eventId}"]`);
            if (tableRow) {
                const participantsCell = tableRow.closest('tr').querySelector('td:nth-child(7) span');
                if (participantsCell) {
                    const maxParticipants = participantsCell.textContent.split('/')[1];
                    participantsCell.textContent = `${data.currentParticipants}/${maxParticipants}`;
                    participantsCell.className = data.currentParticipants >= maxParticipants ? 'text-red-600' : 'text-green-600';
                }
            }
            
            Swal.fire({
                icon: 'success',
                title: 'Succès',
                text: data.message,
                confirmButtonColor: '#3b82f6',
                timer: 2000
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Erreur',
                text: data.message,
                confirmButtonColor: '#3b82f6'
            });
        }
    } catch (error) {
        console.error('Erreur:', error);
        Swal.fire({
            icon: 'error',
            title: 'Erreur',
            text: 'Erreur lors de la suppression du participant',
            confirmButtonColor: '#3b82f6'
        });
    }
}

// Fonction de confirmation de suppression avec SweetAlert2
function confirmDelete(event, itemType) {
    event.preventDefault();
    Swal.fire({
        title: 'Êtes-vous sûr ?',
        text: `Voulez-vous vraiment supprimer cet ${itemType} ?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Oui, supprimer',
        cancelButtonText: 'Annuler'
    }).then((result) => {
        if (result.isConfirmed) {
            event.target.submit();
        }
    });
    return false;
}
</script>

