<% if (typeof successMessage !== 'undefined' && successMessage) { %>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        Swal.fire({
            icon: 'success',
            title: 'Succès !',
            text: '<%= successMessage %>',
            confirmButtonColor: '#3b82f6',
            timer: 3000,
            showConfirmButton: false
        });
    });
</script>
