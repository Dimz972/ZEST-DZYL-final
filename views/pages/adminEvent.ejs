<!-- Main modal -->
<div id="defaultModal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-modal md:h-full">
    <div class="relative p-4 w-full max-w-4xl h-full md:h-auto">
        <!-- Modal content -->
    <div class="relative p-4 bg-white rounded-lg shadow dark:bg-gray-800 sm:p-5 max-w-4xl mx-auto w-full">
            <!-- Modal header -->
            <section class="bg-gray-50 rounded-lg py-4 antialiased dark:bg-gray-900 md:py-12">
    <div class="mx-auto max-w-screen-xl px-4 2xl:px-0">
        <div class="px-4 mx-auto max-w-4xl">
            <h1 class="text-3xl font-bold text-center mb-6 text-blue-600">Ajouter un événement</h1>
            
            <!-- Carte formulaire -->
            <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-md dark:border-gray-700 dark:bg-gray-800">
                <form action="/events/add" method="POST" id="eventForm" enctype="multipart/form-data">
                    <div class="grid gap-6 grid-cols-1 lg:grid-cols-2">
                        <!-- Section Image -->
                        <div>
                            <label for="image" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Image de l'événement</label>
                            <div class="h-56 w-full border-2 border-dashed border-gray-300 rounded-lg flex items-center justify-center bg-gray-50 dark:bg-gray-700 dark:border-gray-600">
                                <input 
                                    type="file" 
                                    id="image" 
                                    name="image"
                                    class="hidden"
                                    accept="image/*"
                                    onchange="previewImage(event)"
                                >
                                <div id="imagePreview" class="hidden h-full w-full">
                                    <img id="previewImg" class="h-full w-full object-cover rounded-lg" src="" alt="Aperçu">
                                </div>
                                <div id="uploadPlaceholder" class="text-center">
                                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                    </svg>
                                    <button type="button" onclick="document.getElementById('image').click()" class="cursor-pointer mt-2 text-sm text-blue-600 hover:text-blue-700">
                                        Cliquez pour ajouter une image
                                    </button>
                                    <p class="text-xs text-gray-500 mt-1">PNG, JPG, GIF jusqu'à 5MB</p>
                                </div>
                            </div>
                        </div>

                        <!-- Section Informations principales -->
                        <div class="space-y-4">
                            <div>
                                <label for="title" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Titre de l'événement</label>
                                <input 
                                    type="text" 
                                    id="title" 
                                    name="title" 
                                    required 
                                    placeholder="Entrez le titre de l'événement"
                                    value="<%= typeof event !== 'undefined' ? event.title : '' %>"
                                    class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-600 focus:border-blue-600 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                >
                            </div>

                            <div>
                                <label for="category" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Catégorie</label>
                                <select id="category" name="category" required class="cursor-pointer w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                    <option value="">Sélectionnez la catégorie</option>
                                    <option value="atelier" <%= typeof event !== 'undefined' && event.category === 'atelier' ? 'selected' : '' %>>🍳 Atelier</option>
                                    <option value="degustation" <%= typeof event !== 'undefined' && event.category === 'degustation' ? 'selected' : '' %>>🍷 Dégustation</option>
                                    <option value="festival" <%= typeof event !== 'undefined' && event.category === 'festival' ? 'selected' : '' %>>🎉 Festival</option>
                                    <option value="cours" <%= typeof event !== 'undefined' && event.category === 'cours' ? 'selected' : '' %>>📚 Cours</option>
                                    <option value="brunch" <%= typeof event !== 'undefined' && event.category === 'brunch' ? 'selected' : '' %>>🥐 Brunch</option>
                                    <option value="soiree" <%= typeof event !== 'undefined' && event.category === 'soiree' ? 'selected' : '' %>>🌙 Soirée</option>
                                </select>
                            </div>

                            <div>
                                <label for="date" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Date</label>
                                <input 
                                    type="date" 
                                    id="date" 
                                    name="date" 
                                    required 
                                    value="<%= typeof event !== 'undefined' ? new Date(event.date).toISOString().split('T')[0] : '' %>"
                                    class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-600 focus:border-blue-600 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                >
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label for="startTime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Heure début</label>
                                    <input 
                                        type="time" 
                                        id="startTime" 
                                        name="startTime" 
                                        required 
                                        value="<%= typeof event !== 'undefined' ? event.startTime : '' %>"
                                        class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-600 focus:border-blue-600 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                    />
                                </div>
                                <div>
                                    <label for="endTime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Heure fin</label>
                                    <input 
                                        type="time" 
                                        id="endTime" 
                                        name="endTime" 
                                        required 
                                        value="<%= typeof event !== 'undefined' ? event.endTime : '' %>"
                                        class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-600 focus:border-blue-600 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                    />
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label for="price" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Prix</label>
                                    <div class="relative">
                                        <input 
                                            type="number" 
                                            id="price" 
                                            name="price" 
                                            required 
                                            step="0.01" 
                                            min="0"
                                            placeholder="0.00"
                                            value="<%= typeof event !== 'undefined' ? event.price : '' %>"
                                            class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-600 focus:border-blue-600 block p-2.5 pr-8 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                        >
                                        <span class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 text-sm">€</span>
                                    </div>
                                </div>
                                <div>
                                    <label for="maxParticipants" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Max participants</label>
                                    <input 
                                        type="number" 
                                        id="maxParticipants" 
                                        name="maxParticipants" 
                                        required 
                                        min="1"
                                        placeholder="20"
                                        value="<%= typeof event !== 'undefined' ? event.maxParticipants : '20' %>"
                                        class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-600 focus:border-blue-600 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                    >
                                </div>
                            </div>

                            <div>
                                <label for="badge" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Badge (optionnel)</label>
                                <div class="flex flex-wrap gap-2">
                                    <select id="badge" name="badge" class="cursor-pointer w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                        <option value="">Aucun badge</option>
                                        <option value="populaire" <%= typeof event !== 'undefined' && event.badge === 'populaire' ? 'selected' : '' %>>🔥 Populaire</option>
                                        <option value="nouveau" <%= typeof event !== 'undefined' && event.badge === 'nouveau' ? 'selected' : '' %>>✨ Nouveau</option>
                                        <option value="special" <%= typeof event !== 'undefined' && event.badge === 'special' ? 'selected' : '' %>>⭐ Spécial</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section Description -->
                    <div class="mt-6">
                        <label for="description" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Description</label>
                        <textarea 
                            id="description" 
                            name="description" 
                            required 
                            placeholder="Décrivez l'événement en détail..."
                            rows="4"
                            class="w-full block p-2.5 text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                        ><%= typeof event !== 'undefined' ? event.description : '' %></textarea>
                    </div>

                    <!-- Section Lieu -->
                    <div class="mt-6">
                        <label for="location" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Lieu</label>
                        <input 
                            type="text" 
                            id="location" 
                            name="location" 
                            required 
                            placeholder="Lieu de l'événement"
                            value="<%= typeof event !== 'undefined' ? event.location : 'Restaurant ZEST\' D\'ZYL' %>"
                            class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-600 focus:border-blue-600 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                        >
                    </div>

                    <!-- Boutons d'action -->
                    <div class="flex gap-4 mt-8 pt-6 border-t border-gray-200 dark:border-gray-600">
                        <button type="submit" 
                                class="btn-hover-effect cursor-pointer flex-1 inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-3 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 transition-colors">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                            </svg>
                            Ajouter l'événement
                        </button>
                        <a href="/events/admin" 
                           class="btn-hover-effect cursor-pointer flex-1 inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white dark:focus:ring-gray-700 transition-colors">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    // Fonctions utilitaires réutilisables
    function previewImageHandler(event, previewId, placeholderId, imgId) {
        const file = event.target.files[0];
        const preview = document.getElementById(previewId);
        const placeholder = document.getElementById(placeholderId);
        const previewImg = document.getElementById(imgId);
        
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                preview.classList.remove('hidden');
                placeholder.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        }
    }

    function validateEventTimes(startTimeId, endTimeId) {
        const startTime = document.getElementById(startTimeId).value;
        const endTime = document.getElementById(endTimeId).value;
        
        if (startTime && endTime && startTime >= endTime) {
            Swal.fire({
                icon: 'error',
                title: 'Erreur de validation',
                text: 'L\'heure de fin doit être après l\'heure de début',
                confirmButtonColor: '#3b82f6'
            });
            return false;
        } else {
            document.getElementById(endTimeId).setCustomValidity('');
            return true;
        }
    }

    function validateEventForm(form, imageRequired = false) {
        const startTimeInput = form.querySelector('input[name="startTime"]');
        const endTimeInput = form.querySelector('input[name="endTime"]');
        
        if (!validateEventTimes(startTimeInput.id, endTimeInput.id)) {
            Swal.fire({
                icon: 'warning',
                title: 'Heures invalides',
                text: 'L\'heure de fin doit être après l\'heure de début',
                confirmButtonColor: '#3b82f6'
            });
            return false;
        }

        if (imageRequired) {
            const imageInput = form.querySelector('input[name="image"]');
            if (!imageInput.files.length) {
                Swal.fire({
                    icon: 'error',
                    title: 'Image requise',
                    text: 'Veuillez sélectionner une image pour l\'événement',
                    confirmButtonColor: '#3b82f6'
                });
                return false;
            }
        }
        
        return true;
    }

    // Fonctions spécifiques pour le formulaire d'ajout
    function previewImage(event) {
        previewImageHandler(event, 'imagePreview', 'uploadPlaceholder', 'previewImg');
    }

    // Validation des heures et de la date
    document.addEventListener('DOMContentLoaded', function() {
        const startTimeInput = document.getElementById('startTime');
        const endTimeInput = document.getElementById('endTime');
        const dateInput = document.getElementById('date');
        
        // Empêcher de sélectionner une date passée
        const today = new Date().toISOString().split('T')[0];
        dateInput.setAttribute('min', today);
        
        function validateTimes() {
            validateEventTimes('startTime', 'endTime');
        }
        
        startTimeInput.addEventListener('change', validateTimes);
        endTimeInput.addEventListener('change', validateTimes);

        // Validation du formulaire d'ajout avant soumission
        document.getElementById('eventForm').addEventListener('submit', function(e) {
            if (!validateEventForm(this, true)) {
                e.preventDefault();
            }
        });
    });
</script>


        </div>
    </div>
  </div>
</div>
            
<% if (events && events.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                    <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                        <tr>
                            <th class="px-4 py-3">Image</th>
                            <th class="px-4 py-3">Titre</th>
                            <th class="px-4 py-3">Description</th>
                            <th class="px-4 py-3">Date</th>
                            <th class="px-4 py-3">Heure</th>
                            <th class="px-4 py-3">Catégorie</th>
                            <th class="px-4 py-3">Participants</th>
                            <th class="px-4 py-3">Prix (€)</th>
                            <th class="px-4 py-3">Badge</th>
                            <th class="px-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% events.forEach(event => { %>
                        <tr class="border-b dark:border-gray-700 align-top">
                            <td class="px-4 py-3">
                                <img src="<%= event.image %>" alt="<%= event.title %>" class="w-16 h-16 object-cover rounded shadow">
                            </td>
                            <td class="px-4 py-3 font-medium text-gray-900 dark:text-white"><%= event.title %></td>
                            <td class="px-4 py-3"><%= event.description %></td>
                            <td class="px-4 py-3"><%= new Date(event.date).toLocaleDateString('fr-FR') %></td>
                            <td class="px-4 py-3"><%= event.startTime %> - <%= event.endTime %></td>
                            <td class="px-4 py-3">
                                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">
                                    <%= event.category %>
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <span class="<%= event.currentParticipants >= event.maxParticipants ? 'text-red-600' : 'text-green-600' %>">
                                        <%= event.currentParticipants %>/<%= event.maxParticipants %>
                                    </span>
                                    <button
                                        data-event-id="<%= event._id %>"
                                        data-event-title="<%= event.title %>"
                                        data-event-participants="<%= event.participants ? event.participants.length : 0 %>"
                                        data-drawer-target="participantsDrawer" 
                                        data-drawer-show="participantsDrawer" 
                                        aria-controls="participantsDrawer"
                                        type="button"
                                        class="cursor-pointer rounded-lg p-1 text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white view-participants-btn"
                                        title="Voir les participants"
                                    >
                                        <span class="sr-only">Voir les participants de l'événement</span>
                                        <svg
                                            class="h-4 w-4"
                                            aria-hidden="true"
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="24"
                                            height="24"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke="currentColor"
                                                stroke-width="2"
                                                d="M21 12c0 1.2-4.03 6-9 6s-9-4.8-9-6c0-1.2 4.03-6 9-6s9 4.8 9 6Z"
                                            />
                                            <path
                                                stroke="currentColor"
                                                stroke-width="2"
                                                d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                                            />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                            <td class="px-4 py-3"><%= event.price %></td>
                            <td class="px-4 py-3">
                                <% if (event.badge) { %>
                                    <span class="bg-<%= event.badge === 'populaire' ? 'red' : event.badge === 'nouveau' ? 'green' : 'purple' %>-100 text-<%= event.badge === 'populaire' ? 'red' : event.badge === 'nouveau' ? 'green' : 'purple' %>-800 text-xs font-medium px-2.5 py-0.5 rounded">
                                        <%= event.badge.charAt(0).toUpperCase() + event.badge.slice(1) %>
                                    </span>
                                <% } %>
                            </td>
                            <td class="px-4 py-3 space-y-2">
                                <!-- Update button -->
                                 <button id="updateModalButton" title="Modifier cet événement" data-modal-target="updateModal" data-modal-toggle="updateModal" class="btn-hover-effect cursor-pointer inline-flex items-center justify-center p-2 text-sm font-medium text-white bg-blue-700 border border-transparent rounded-lg hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
                                 data-id="<%= event._id %>"
                                    data-title="<%= event.title %>"
                                    data-description="<%= event.description %>"
                                    data-date="<%= new Date(event.date).toISOString().split('T')[0] %>"
                                    data-starttime="<%= event.startTime %>"
                                    data-endtime="<%= event.endTime %>"
                                    data-location="<%= event.location %>"
                                    data-capacity="<%= event.capacity %>"
                                    data-price="<%= event.price %>"
                                    data-badge="<%= event.badge || '' %>"
                                >
                                   <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                 </button>
                                <!-- Delete Form -->
                                <form action="/events/delete/<%= event._id %>?_method=DELETE" method="POST" class="mb-2" onsubmit="return confirmDelete(event, 'événement')">
                                     <button type="submit" title="Supprimer cet événement" class="btn-hover-effect cursor-pointer inline-flex items-center justify-center p-2 text-sm font-medium text-white bg-red-700 rounded-lg hover:bg-red-800 focus:ring-4 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800">
                                       <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                       </svg>
                                     </button>
                                </form>             
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-12">
                <h2 class="text-2xl font-semibold text-gray-600 mb-4">Aucun événement disponible</h2>
                <p class="text-gray-500">Commencez par ajouter votre premier événement !</p>
            </div>
      
        <% } %>
        </div>
    </div>
</section>

